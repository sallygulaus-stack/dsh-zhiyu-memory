{
  "name": "dsh-zhiyu-memory",
  "version": "0.1.18",
  "private": true,
  "type": "module",
  "description": "给 DeepSeek Harness 的长期记忆：每条都追得回原话，按类型自然淡化，可纠正、可分级删除。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sallygulaus-stack/dsh-zhiyu-memory.git"
  },
  "main": "./plugin/lib/index.js",
  "exports": {
    ".": "./plugin/lib/index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "plugin/lib/index.js",
    "plugin/lib/console.js",
    "plugin/lib/pricing.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "run:smoke": "node src/cli.mjs smoke",
    "run:live": "node src/cli.mjs live",
    "run:migrate-puppet": "node src/migrate-puppet-memory.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
